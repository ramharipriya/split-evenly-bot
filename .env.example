# Copy to .env and fill in. Never commit .env.
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-botfather-token
ANTHROPIC_API_KEY=sk-ant-replace-with-your-key

# Optional
CLAUDE_MODEL=claude-opus-5-5
DB_PATH=data/splitbot.db

# Webhook mode (e.g. Railway). Leave WEBHOOK_URL empty to use polling.
WEBHOOK_URL=
WEBHOOK_SECRET=
PORT=8080
